# === Database (Dev: PostgreSQL | Prod: SAP HANA) ===
DB_HOST=postgres-dev
DB_PORT=5432
DB_NAME=zesa_billing
DB_USER=zesa_admin
DB_PASSWORD=zesa_dev_pass

# HANA Production (commented for dev)
# USE_HANA=true
# HANA_HOST=10.0.1.10
# HANA_PORT=30015
# HANA_USER=SYSTEM
# HANA_PASSWORD=
# HANA_TENANT_DB=HDB

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# === Backend ===
NODE_ENV=development
PORT=4000
JWT_SECRET=your-jwt-secret-here
API_RATE_LIMIT=100
LOG_LEVEL=info

# === Frontend ===
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME="ZESA Billing Ops"

# === Monitoring ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
