# ============================================================
# ZESA HANA Billing — Global .gitignore
# ============================================================

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker volumes (auto-created, do not commit)
volumes/

# Temporary files
tmp/
temp/
*.tmp

# Build artifacts (root level)
dist/
build/
coverage/
